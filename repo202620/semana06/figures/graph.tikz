\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=new style 0] (0) at (-2.5, 2) {0};
		\node [style=new style 0] (1) at (2.5, 2) {1};
		\node [style=new style 0] (2) at (-2.5, -2) {2};
		\node [style=new style 0] (3) at (2.5, -2) {3};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (0) to (1);
		\draw (0) to (2);
		\draw (2) to (3);
		\draw (1) to (2);
	\end{pgfonlayer}
\end{tikzpicture}
